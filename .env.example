# Copia este archivo como .env.local y completa los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# Base de datos Neon (Paso 4). En el panel de Neon: Connect > Connection
# string (elige "Pooled connection"). Empieza con postgresql://
DATABASE_URL=

# Vercel Blob, para las imágenes de proyectos (Paso 7)
BLOB_READ_WRITE_TOKEN=

# Autenticación del panel de administración (Paso 7)
AUTH_SECRET=

# Aviso por correo cuando llega un mensaje de contacto, opcional (Paso 6)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
